# Supabase Project Settings
# Lấy từ Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Web Push VAPID Keys (chạy `npx web-push generate-vapid-keys` để tạo)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:shop@example.com

# Bảo mật nội bộ cho Supabase pg_cron gọi /api/cron/reminders
# Tạo chuỗi ngẫu nhiên >= 32 ký tự
CRON_SECRET=replace-with-a-random-32-char-secret
